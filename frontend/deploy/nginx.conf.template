# envsubst của image nginx chỉ thay các biến môi trường đã khai báo (API_URL); $host, $uri... giữ nguyên
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # File build có hash trong tên → cache lâu dài
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA: mọi route khác trả index.html (không cache để luôn lấy bản mới)
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
